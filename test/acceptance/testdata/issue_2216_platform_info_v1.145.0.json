    "error": {
      "description": "Machine-readable error envelope; present only when the call failed. Branch on error.code / error.category rather than parsing the message prose.",
      "properties": {
        "category": {
          "description": "error category the caller can branch on (e.g. client_input, internal)",
          "type": "string"
        },
        "code": {
          "description": "stable snake_case error code (e.g. not_found, unauthorized)",
          "type": "string"
        },
        "hint": {
          "description": "corrective guidance for the caller, when available",
          "type": "string"
        },
        "message": {
          "description": "human-readable failure message",
          "type": "string"
        },
        "retry_after_seconds": {
          "description": "seconds after which the same call is expected to be admitted; present only on a rate_limited refusal",
          "type": "integer"
        }
      },
      "type": "object"
    },
