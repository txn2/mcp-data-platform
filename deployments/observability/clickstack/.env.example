# Copy to .env and fill in. compose.yaml refuses to start without the two
# secrets.

# The key the edge collector sends with every signal; ClickStack accepts it in
# place of a team ingestion key. Any long random string.
CLICKSTACK_INGESTION_KEY=

# The first HyperDX user, created by the seed on a fresh install (evaluation
# only; the seed then signs in as it to read an API key).
HYPERDX_SEED_EMAIL=admin@example.com
HYPERDX_SEED_PASSWORD=

# Where alerts are sent: a generic webhook (any URL that accepts a JSON POST).
# Unset, the seed creates the dashboards and saved searches and skips alerts.
HYPERDX_ALERT_WEBHOOK_URL=

# This deployment's identity on signals that carry none of their own.
EDGE_DEPLOYMENT_ID=local
EDGE_ENVIRONMENT=evaluation

# Retention per signal, Go durations.
CLICKSTACK_TRACES_TTL=168h
CLICKSTACK_LOGS_TTL=336h
CLICKSTACK_METRICS_TTL=720h

# The PostgreSQL the substrate receivers read (compose.substrate.yaml only).
SUBSTRATE_PG_HOST=host.docker.internal
SUBSTRATE_PG_PORT=5432
SUBSTRATE_PG_USER=otel_monitor
SUBSTRATE_PG_PASSWORD=
SUBSTRATE_PG_DATABASE=mcp_platform
SUBSTRATE_PG_SSLMODE=disable
SUBSTRATE_PG_TLS_INSECURE=true
SUBSTRATE_SEAWEEDFS_METRICS=host.docker.internal:9327
