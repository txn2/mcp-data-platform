# The platform side of the ClickStack bundle: pass these to mcp-data-platform
# (an env_file, a Deployment's env, or exported before it starts). They point
# every signal at the edge collector in compose.yaml and turn on what the
# dashboards read. The Kubernetes equivalent is k8s/platform-env-patch.yaml.

# Traces: every span leaves the platform; the edge collector's tail sampling
# keeps the errors and slow ones and thins the rest. At the platform's default
# head ratio (0.1) about nine in ten error traces would never reach it.
OTEL_TRACES_ENABLED=true
OTEL_TRACES_SAMPLER_ARG=1.0

# Metrics and logs over OTLP beside the traces.
OTEL_METRICS_ENABLED=true
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp

# The edge collector (compose publishes its gRPC port on 4317).
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true

# Who this deployment is, on every signal; the dashboards' Deployment and
# Environment filters read these.
MCP_PLATFORM_DEPLOYMENT_ID=my-deployment
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=production

# Optional: a byte budget per bucket, for the storage dashboard's days-to-budget
# and the over-budget alert (a cloud bucket has no "free").
# MCP_PLATFORM_STORAGE_BUDGETS=portal-assets=200GiB,managed-resources=500GiB
