<!-- ClickHouse's own Prometheus endpoint, off in the ClickStack image. Mounted
     into /etc/clickhouse-server/config.d/ so the substrate collector can watch
     the backend's disk, parts and rejected inserts (collector-substrate.yaml).
     A backend that fills its own disk hides every other problem. -->
<clickhouse>
    <prometheus>
        <endpoint>/metrics</endpoint>
        <port>9363</port>
        <metrics>true</metrics>
        <events>true</events>
        <asynchronous_metrics>true</asynchronous_metrics>
    </prometheus>
</clickhouse>
